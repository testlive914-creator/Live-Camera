PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Allowed Origins for CORS (Comma-separated list of origins)
# For mobile testing over local LAN:
# ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.15:5173,https://my-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Supabase Configuration (Optional for local memory testing, required for cloud production)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=video-recordings

# WebRTC STUN/TURN (STUN is free via Google, TURN is optional for strict symmetric NATs)
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
