# ==========================================
# Live Selfie Connect Environment Template
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Allowed Origins for CORS (Comma-separated list of origins)
# Example for testing with your phone on local Wi-Fi:
# ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.15:5173,https://my-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Supabase (PostgreSQL Database, Admin Auth & Private Video Storage)
# Get these free from https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=video-recordings

# WebRTC STUN/TURN (Free STUN servers are pre-configured)
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Frontend Configuration (.env inside /frontend)
# VITE_API_URL=http://localhost:5000
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
